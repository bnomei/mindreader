{
  "name": "mindreader",
  "version": "0.3.0",
  "description": "Deterministic, privacy-first Neo4j memory MCP server",
  "transport": {
    "type": "stdio",
    "command": "mindreader",
    "args": []
  },
  "environment": [
    "NEO4J_PASSWORD",
    "OPENAI_API_KEY",
    "XAI_API_KEY"
  ],
  "tools": [
    "memory_recall",
    "memory_write",
    "memory_revise",
    "memory_withdraw",
    "memory_judge",
    "memory_place",
    "memory_unify"
  ]
}
