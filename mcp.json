{
  "name": "mindreader",
  "version": "0.2.0",
  "description": "Deterministic, privacy-first Neo4j memory MCP server",
  "transport": {
    "type": "stdio",
    "command": "mindreader",
    "args": []
  },
  "environment": [
    "NEO4J_PASSWORD",
    "OPENAI_API_KEY",
    "XAI_API_KEY"
  ],
