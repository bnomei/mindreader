{
  "name": "mindreader",
  "version": "0.4.0",
  "description": "Deterministic Neo4j graph memory for MCP agents: explicit triples, no hidden extraction",
  "transport": {
    "type": "stdio",
    "command": "mindreader",
    "args": []
  },
  "environment": [
    "NEO4J_PASSWORD",
    "OPENAI_API_KEY",
    "XAI_API_KEY"
  ],
  "tools": [
    "memory_recall",
    "memory_recall_semantic",
    "memory_write",
    "memory_revise",
    "memory_withdraw",
    "memory_judge",
    "memory_place",
    "memory_unify"
  ]
}
