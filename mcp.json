{
  "name": "mindreader",
  "version": "0.5.0",
  "description": "Agent-driven durable Neo4j graph memory for MCP: proactive recall and explicit fact capture without hidden extraction",
  "transport": {
    "type": "stdio",
    "command": "mindreader",
    "args": []
  },
  "environment": [
    "NEO4J_PASSWORD",
    "OPENAI_API_KEY",
    "XAI_API_KEY"
  ],
  "tools": [
    "recall",
    "recall_semantic",
    "write",
    "revise",
    "withdraw",
    "judge",
    "place",
    "unify"
  ]
}
